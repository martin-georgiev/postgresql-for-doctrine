includes:
    - ../../vendor/ekino/phpstan-banned-code/extension.neon
    - ../../vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - ../../vendor/phpstan/phpstan-doctrine/extension.neon
    - ../../vendor/phpstan/phpstan-phpunit/extension.neon
    - ./baselines/deprecated-methods.neon
    - ./baselines/doctrine-version-variations.neon
    - ./baselines/lexer-variations.neon
    - ./baselines/phpstan-identifiers.neon
    - ./baselines/range-baseline.neon

services:
    -
        # The class-level docblock each namespace owes. Longest matching prefix wins, so the
        # exception sub-namespaces owe only @since and @author while their parents owe the full shape.
        class: MartinGeorgiev\PHPStan\ClassDocBlockRule
        tags:
            - phpstan.rules.rule
        arguments:
            requirementsByNamespacePrefix:
                'MartinGeorgiev\Doctrine\DBAL\Types\': ['description', 'see', 'since', 'author']
                'MartinGeorgiev\Doctrine\DBAL\Types\Exceptions\': ['since', 'author']
                'MartinGeorgiev\Doctrine\DBAL\Types\ValueObject\': ['description', 'see', 'since', 'author']
                'MartinGeorgiev\Doctrine\DBAL\Types\ValueObject\Exceptions\': ['description', 'since', 'author']
                'MartinGeorgiev\Doctrine\ORM\Query\AST\Functions\': ['description', 'see', 'since', 'author', 'implementationFirstLine']
                'MartinGeorgiev\Doctrine\ORM\Query\AST\Functions\Exception\': ['since', 'author']
                'MartinGeorgiev\Utils\Exception\': ['since', 'author']
    # the value object conventions nothing else was keeping - see .ai-tools/rules/dbal-value-object-conventions.md
    -
        class: MartinGeorgiev\PHPStan\ValueObjectImmutabilityRule
        tags: [phpstan.rules.rule]
    -
        class: MartinGeorgiev\PHPStan\ValueObjectRequiredMethodsRule
        tags: [phpstan.rules.rule]
    -
        class: MartinGeorgiev\PHPStan\ValueObjectExceptionNamingRule
        tags: [phpstan.rules.rule]

parameters:
    # Re-lists every node the extension bans by default, because supplying an Expr_FuncCall
    # entry replaces the shipped one (BannedNodesRule keys the list by node type).
    # Only gettype and get_debug_type are new — see .ai-tools/rules/exceptions.md § Message Formatting.
    banned_code:
        nodes:
            -
                type: Stmt_Echo
                functions: null
            -
                type: Expr_Eval
                functions: null
            -
                type: Expr_Exit
                functions: null
            -
                type: Expr_FuncCall
                functions:
                    - dd
                    - debug_backtrace
                    - dump
                    - exec
                    - get_debug_type
                    - gettype
                    - passthru
                    - phpinfo
                    - print_r
                    - proc_open
                    - shell_exec
                    - system
                    - var_dump
            -
                type: Expr_Print
                functions: null
            -
                type: Expr_ShellExec
                functions: null

    level: max
    paths:
        - ../../ci
        - ../../fixtures
        - ../../src
        - ../../tests

    tmpDir: ../../var/cache/phpstan

    parallel:
        maximumNumberOfProcesses: 4

    errorFormat: table
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
