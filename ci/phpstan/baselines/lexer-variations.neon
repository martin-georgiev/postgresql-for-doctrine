# Doctrine ORM changed how DQL tokens are modelled between 2.x and 3.x:
# ORM 2.x still carries the deprecated Doctrine\ORM\Query\Lexer::T_* constants and
# accepts int|string tokens, while ORM 3.x dropped the constants in favour of the
# Doctrine\ORM\Query\TokenType enum. Every entry below is therefore matched on one
# side of that split and unmatched on the other, so each is exempted from
# reportUnmatchedIgnoredErrors rather than deleted.
parameters:
    ignoreErrors:
        # The array access on lookahead is only reachable with lexer 1.x, and the two lexer
        # majors report it under different identifiers - notFound on 2.x, nonOffsetAccessible
        # on 3.x - so it cannot be named by an in-code ignore that holds on every cell.
        -
            message: "#Offset 'type' might not exist on Doctrine\\\\Common\\\\Lexer\\\\Token#"
            path: ../../../src/MartinGeorgiev/Utils/DoctrineLexer.php
            reportUnmatched: false
        -
            message: '#Cannot access offset .type. on Doctrine\\Common\\Lexer\\Token#'
            path: ../../../src/MartinGeorgiev/Utils/DoctrineLexer.php
            reportUnmatched: false

        # Matched with ORM 3.x only (the Lexer class survives, its T_* constants do not).
        -
            message: '#Access to undefined constant Doctrine\\ORM\\Query\\Lexer::T_[A-Z_]+#'
            reportUnmatched: false

        # Matched with ORM 2.x only (constants still present, but deprecated).
        -
            message: '#Fetching deprecated class constant T_IDENTIFIER of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_OPEN_PARENTHESIS of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_CLOSE_PARENTHESIS of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_COMMA of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_ORDER of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_INTEGER of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_FLOAT of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_AS of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_NONE of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_DISTINCT of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false
        -
            message: '#Fetching deprecated class constant T_STRING of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false

        # Matched with ORM 3.x only (TokenType enum replaced the int|string token).
        -
            message: '#Parameter \#1 \$token of method Doctrine\\ORM\\Query\\Parser::match\(\) expects Doctrine\\ORM\\Query\\TokenType, mixed given.#'
            reportUnmatched: false
        -
            message: '#Parameter \#1 \$type of method Doctrine\\Common\\Lexer\\AbstractLexer<Doctrine\\ORM\\Query\\TokenType,string>::isNextToken\(\) expects Doctrine\\ORM\\Query\\TokenType, mixed given.#'
            reportUnmatched: false
