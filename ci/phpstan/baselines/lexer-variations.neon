# ORM 2.x carries the deprecated Doctrine\ORM\Query\Lexer::T_* constants; ORM 3.x dropped them for the TokenType enum.
# Every entry below matches one side of that split and not the other, so each is exempted rather than deleted.
parameters:
    ignoreErrors:
        # The lookahead array access is lexer 1.x only, and the two majors report it under different identifiers
        # - notFound on 2.x, nonOffsetAccessible on 3.x - so no single in-code ignore holds on every cell.
        -
            message: "#Offset 'type' might not exist on Doctrine\\\\Common\\\\Lexer\\\\Token#"
            path: ../../../src/MartinGeorgiev/Utils/DoctrineLexer.php
            reportUnmatched: false
        -
            message: '#Cannot access offset .type. on Doctrine\\Common\\Lexer\\Token#'
            path: ../../../src/MartinGeorgiev/Utils/DoctrineLexer.php
            reportUnmatched: false

        # Matched with ORM 3.x only (the Lexer class survives, its T_* constants do not).
        -
            message: '#Access to undefined constant Doctrine\\ORM\\Query\\Lexer::T_[A-Z_]+#'
            reportUnmatched: false

        # Matched with ORM 2.x only (constants still present, but deprecated).
        -
            message: '#Fetching deprecated class constant T_(AS|CLOSE_PARENTHESIS|COMMA|DISTINCT|FLOAT|GROUP|IDENTIFIER|INTEGER|NONE|OPEN_PARENTHESIS|ORDER|STRING|WHERE) of class Doctrine\\ORM\\Query\\Lexer#'
            reportUnmatched: false

        # Matched with ORM 3.x only (TokenType enum replaced the int|string token).
        -
            message: '#Parameter \#1 \$token of method Doctrine\\ORM\\Query\\Parser::match\(\) expects Doctrine\\ORM\\Query\\TokenType, mixed given.#'
            reportUnmatched: false
        -
            message: '#Parameter \#1 \$type of method Doctrine\\Common\\Lexer\\AbstractLexer<Doctrine\\ORM\\Query\\TokenType,string>::isNextToken\(\) expects Doctrine\\ORM\\Query\\TokenType, mixed given.#'
            reportUnmatched: false
